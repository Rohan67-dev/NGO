# ==========================================
# NGO Impact-Driven E-Commerce Platform
# Copy the values you need into your shell / hosting environment.
# Never commit real secrets. Backend variables are read by Spring Boot;
# only VITE_* variables are exposed to the browser - never put secrets in them.
# ==========================================

# ---------- Frontend (Vite) ----------
# Leave unset in development: the Vite dev server proxies /api to http://localhost:8080.
# Set only when the API is served from a different origin in production.
# VITE_API_BASE_URL=https://api.example.org/api

# ---------- Backend: server ----------
# SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Backend: database ----------
# Default (unset): file-based H2 at backend/data/ngodb (data survives restarts).
# PostgreSQL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/ngo_impact_db
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=change-me
# DATABASE_DRIVER=org.postgresql.Driver
# HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# H2_CONSOLE_ENABLED=false

# ---------- Backend: security ----------
# REQUIRED outside local development: a random string of at least 32 characters.
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Create an administrator on startup (recommended for real deployments instead of demo accounts)
# APP_ADMIN_EMAIL=admin@your-ngo.org
# APP_ADMIN_PASSWORD=at-least-8-characters

# Seed clearly-labelled demo products/content and demo accounts into an EMPTY database.
# Set to false for a real deployment.
APP_SEED_DEMO_DATA=true

# ---------- Backend: Razorpay ----------
# Get test keys from https://dashboard.razorpay.com (Test Mode). With the placeholders,
# checkout reports that online payment is not configured (no payment is ever faked).
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
# Webhook URL: https://<your-host>/api/payments/webhook  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ---------- Backend: order pricing ----------
# ORDER_FREE_SHIPPING_THRESHOLD=999
# ORDER_SHIPPING_FEE=99
# ORDER_TAX_RATE=0.05

# ---------- Backend: NGO details shown on the site ----------
# NGO_NAME=Your NGO name
# NGO_EMAIL=contact@your-ngo.org
# NGO_PHONE=+91 ...
# NGO_ADDRESS=Full postal address
